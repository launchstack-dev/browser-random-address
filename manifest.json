{
  "manifest_version": 3,
  "name": "Random Address",
  "version": "0.1.0",
  "description": "Random US name, address, phone and email for signup forms, offline. Optional Firefox Relay or DuckDuckGo aliases.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Random Address",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://relay.firefox.com https://quack.duckduckgo.com; base-uri 'none'; form-action 'none'"
  },
  "optional_host_permissions": [
    "https://relay.firefox.com/*",
    "https://quack.duckduckgo.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "random-address@launchstack.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "authenticationInfo",
          "browsingActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
